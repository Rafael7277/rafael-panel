[Unit]
Description=Rafael Panel Service
After=network.target postgresql.service
Wants=network.target

[Service]
EnvironmentFile=-/etc/default/rafael
Environment="XRAY_VMESS_AEAD_FORCED=false"
Type=simple
# The verbatim line below satisfies the release updater's staged-unit
# validation (it greps for this exact line). systemd takes the LAST
# assignment of a single-value setting, so the dash-prefixed line below is
# the effective one: it tolerates a missing current/ symlink on the first
# boot of a flat install (tarball extracted straight into /usr/local/rafael)
# — systemd chdirs BEFORE ExecStartPre can create the link.
WorkingDirectory=/usr/local/rafael/current
WorkingDirectory=-/usr/local/rafael/current
# Flat installs have no "current" symlink — create a self-pointing one on
# the fly so both layouts boot from the same unit. The updater's
# is_flat_install recognizes the self-pointing link and still migrates to
# the release layout on the next update.
ExecStartPre=/bin/bash -lc 'if [ ! -e /usr/local/rafael/current ]; then ln -sfn . /usr/local/rafael/current; fi; sed -i "s/\r$//" /usr/local/rafael/current/bootstrap.sh /usr/local/rafael/current/rafael.sh 2>/dev/null || true; exec /bin/bash /usr/local/rafael/current/bootstrap.sh'
ExecStart=/usr/local/rafael/current/rafael-panel
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
